{
  "name": "@mirayavandiepen/bricka",
  "version": "0.1.0",
  "description": "A composable input for AI apps: inline context tokens, @ mentions, / commands, ghost-text autocomplete and attachments.",
  "keywords": [
    "react",
    "composer",
    "prompt",
    "mentions",
    "commands",
    "autocomplete",
    "contenteditable",
    "ai",
    "chat",
    "input"
  ],
  "author": "Miraya van Diepen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirayavandiepen/bricka.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/mirayavandiepen/bricka#readme",
  "bugs": {
    "url": "https://github.com/mirayavandiepen/bricka/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "cp ../../LICENSE ../../README.md .",
    "postpack": "rm -f LICENSE README.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
